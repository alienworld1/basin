# Basin deployment class: development, preview, or production.
APP_ENV=development

# Required for preview and production. Development defaults to localhost.
APP_URL=http://localhost:3000

# Optional public tunnel URL used by the frontend and Privy webhook in local development.
# The origin is trusted for browser mutations only outside production. A webhook path is optional.
PRIVY_WEBHOOK_PUBLIC_URL=

# Privy development app credentials. Only the NEXT_PUBLIC value enters the browser bundle.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional when the Privy app uses an app client for domain-specific sessions.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Server-only credentials used to verify access tokens. Never prefix these with NEXT_PUBLIC_.
PRIVY_APP_SECRET=

# Optional PEM verification key from the Privy dashboard; avoids a runtime key fetch.
PRIVY_JWT_VERIFICATION_KEY=

# Server-only Svix secret used to verify Privy webhook deliveries.
PRIVY_WEBHOOK_SIGNING_SECRET=

# Dedicated AES-256 key for per-organization routine signer credentials.
# Never reuse SETTLEMENT_ENCRYPTION_KEY.
TREASURY_ROUTINE_KEY_ENCRYPTION_KEY=
TREASURY_ROUTINE_KEY_VERSION=v1

# Required for Basin identity availability, verification, and registration.
SEPOLIA_RPC_URL=

# ENSv2 UserRegistry mounted at basin.eth on the pinned Sepolia deployment.
ENSV2_BASIN_REGISTRY_ADDRESS=

# Server-only funded signer holding only registrar/renew roles on the Basin registry.
ENSV2_REGISTRAR_PRIVATE_KEY=

# Local deployment tooling only. Never load this key into the web application.
DEV_PRIVATE_KEY=

# Optional deployment revision, commit SHA, or release identifier.
DEPLOYMENT_REVISION=

# Required server-only Postgres runtime URL. Use a least-privilege application role.
# For hosted deployments, use the provider's recommended transaction pooler URL.
DATABASE_URL=

# Direct/session connection with migration privileges. Required outside local/test.
# Never use migration credentials for the runtime or expose either URL to the browser.
DATABASE_MIGRATION_URL=

# Integration tests only: local Postgres admin connection with CREATEDB privileges.
# Tests create and drop a randomly named database; existing databases are never reset.
TEST_DATABASE_ADMIN_URL=

# Reviewed single Sepolia receiving asset. No default address is assumed.
SETTLEMENT_ASSET_ADDRESS=
SETTLEMENT_ASSET_SYMBOL=

# Server-only 32-byte AES key as 64 hex characters; generate with openssl rand -hex 32.
# Retain the key while any saved preferences or settlement descriptors use it.
SETTLEMENT_ENCRYPTION_KEY=
SETTLEMENT_KEY_VERSION=v1

# Optional override for the pinned activation-only Sepolia deployment manifest.
# Active relationships still require bytecode, ENS state, and receipt read-back.
BASIN_ACTIVATION_ROUTER_ADDRESS=
BASIN_ACTIVATION_ROUTER_VERSION=1
