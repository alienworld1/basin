{
  "name": "@basin/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./evidence": "./src/evidence.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "generate": "drizzle-kit generate && tsx scripts/manifest.ts",
    "migrate": "tsx scripts/migrate.ts",
    "status": "tsx scripts/status.ts",
    "test": "NODE_OPTIONS=--conditions=react-server tsx --test test/*.test.ts",
    "check": "tsx scripts/check.ts",
    "test:http": "tsx test/health-http.ts"
  },
  "dependencies": {
    "@basin/domain": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "@next/env": "16.3.4"
  }
}
