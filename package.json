{
  "name": "basin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @basin/db generate",
    "db:migrate": "pnpm --filter @basin/db migrate",
    "db:status": "pnpm --filter @basin/db status",
    "test:db": "pnpm --filter @basin/db test",
    "db:check": "pnpm --filter @basin/db check",
    "start": "pnpm db:check && pnpm --filter web start"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
